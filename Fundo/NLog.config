<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

	<!-- 1. Extensions: load extra NLog features -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore"/>
	</extensions>

	<!-- 2. Variables: reusable values -->
	<variable name="logDirectory" value="${basedir}/logs" />
	<variable name="commonLayout"
			  value="${longdate} | ${level:uppercase=true:padding=-5} | ${logger} | ${message} ${exception:format=tostring}" />

	<!-- 3. Targets: where logs go -->
	<targets async="true">

		<!-- Everything goes here -->
		<target xsi:type="File"
				name="fileTarget"
				fileName="${logDirectory}/all-${shortdate}.log"
				layout="${commonLayout}"
				archiveEvery="Day"
				maxArchiveFiles="14"
				keepFileOpen="true"
				encoding="utf-8" />

		<!-- Only errors and above go here -->
		<target xsi:type="File"
				name="errorFile"
				fileName="${logDirectory}/errors-${shortdate}.log"
				layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message}${newline}${exception:format=tostring}${newline}URL: ${aspnet-request-url}${newline}Action: ${aspnet-mvc-controller}/${aspnet-mvc-action}${newline}User: ${aspnet-user-identity}${newline}"
				maxArchiveFiles="30" />

		<!-- Console output while developing -->
		<target xsi:type="Console"
				name="console"
				layout="${time} ${level:uppercase=true:padding=-5} ${logger:shortName=true} ${message} ${exception:format=message}" />
	</targets>

	<!-- 4. Rules: which logs go to which target -->
	<rules>

		<logger name="*" minlevel="Info" writeTo="fileTarget" />

		<!-- Silence noisy Microsoft messages below Warn 
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<logger name="System.Net.Http.*" maxlevel="Info" final="true" />
		-->
		
		<!-- ><logger name="*" minlevel="Trace" writeTo="allFile" />
		<logger name="*" minlevel="Error" writeTo="errorFile" />
		<logger name="*" minlevel="Debug" writeTo="console" />
		 -->
	</rules>
</nlog>